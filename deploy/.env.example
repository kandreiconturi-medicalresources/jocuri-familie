# Copiază acest fișier ca `.env` lângă docker-compose.yml și completează valorile.
# Nu pune niciodată fișierul .env pe GitHub.

# Cheia de autentificare Tailscale (Settings → Keys → Generate auth key), cu tag-ul tag:jocuri.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX

# Primul cont de părinte (admin). Se folosește doar la prima pornire, când nu există încă niciun admin.
# Parola: cel puțin 10 caractere. După prima pornire o poți șterge de aici.
ADMIN_USER=parinte
ADMIN_PASSWORD=schimba-ma-acum-123

# Fusul orar al containerelor (ziua de joc se calculează oricum în Europe/Bucharest).
TZ=Europe/Bucharest
