{
  "name": "jocuri-familie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jocuri arcade pentru familie: Bobo, Bum-Bum Arena, Turbo Curse, Orășelul",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --env-file=server/dev.env server/src/index.js",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.js\" \"server/test/*.test.js\"",
    "icons": "node tools/make-icons.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
